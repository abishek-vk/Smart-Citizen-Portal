PORT=5000
BASE_PATH=/

# Use your Supabase Postgres connection string here.
# Example: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Optional fallback if you prefer naming the Supabase connection explicitly.
SUPABASE_DATABASE_URL=

# Local frontend API endpoint. The app defaults to http://localhost:5000 in dev.
VITE_API_BASE_URL=http://localhost:5000

# Clerk auth
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PROXY_URL=