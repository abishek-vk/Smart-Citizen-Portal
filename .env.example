PORT=5000
BASE_PATH=/

# Use your Supabase Postgres connection string here.
# Example: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Optional fallback if you prefer naming the Supabase connection explicitly.
SUPABASE_DATABASE_URL=

# Frontend API endpoint. Defaults to http://localhost:5000 automatically in local dev.
# In production (e.g. Render Static Site), set VITE_API_URL to your deployed backend URL.
VITE_API_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000

# Clerk auth
# In local dev, the app falls back to https://frontend-api.clerk.dev if this is blank.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PROXY_URL=

# AI assistant
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant